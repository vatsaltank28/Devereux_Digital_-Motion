# Public site URL (used for canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ---- Published contact details (leave blank to hide them everywhere) ----
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_BEHANCE_URL=

# ---- Enquiry form delivery (server-side only; pick ONE provider) ----
# Option A: Resend (https://resend.com)
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=
ENQUIRY_TO_EMAIL=

# Option B: any webhook (Zapier, Make, n8n, CRM inbound URL). Receives the validated JSON payload.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=

# ---- Optional ----
# Cloudflare Turnstile spam protection (https://developers.cloudflare.com/turnstile/)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
